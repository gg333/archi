{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archi",
  "version": "0.4.0",
  "identifier": "com.nitivar.archi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Archi",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "fileAssociations": [
      {
        "ext": [
          "zip",
          "7z",
          "rar",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz",
          "zst",
          "cab",
          "iso",
          "lzh",
          "lha",
          "ar",
          "cpio",
          "001"
        ],
        "contentTypes": [
          "public.archive"
        ],
        "name": "Archive",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "externalBin": [
      "binaries/7zz"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third_party/7zip": "third_party/7zip",
      "../third_party/dependency-licenses": "third_party/dependency-licenses"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
